[Unit]
Description=PyCentric Sovereign Service - pummel (pummel-server)
After=network-online.target

[Container]
Image=ghcr.io/py-centric/pummel-server:latest
ContainerName=pummel-server
PublishPort=127.0.0.1:8090:8090
Volume=%h/.local/share/pummel-server:/data:Z
Environment=PORT=8090
NoNewPrivileges=true
DropCapability=ALL

[Service]
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
